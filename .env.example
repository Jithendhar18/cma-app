# CMA Study OS: browser environment. Copy to .env.local (ignored by Git) and fill in only if you enable accounts.
#
# EVERY VITE_ VARIABLE IS COMPILED INTO THE PUBLIC BUNDLE. Never put a secret here:
# no privileged key, no database password, no access token. The secret guard (npm run guard:secrets) fails the build if you do.

# Account sign-in is OFF unless this is exactly "true". Leave it off and the app runs in local mode with no network calls to Supabase.
VITE_SUPABASE_AUTH_ENABLED=false

# Your Supabase project's API URL (https://<project-ref>.supabase.co) or the local stack (http://127.0.0.1:54321).
VITE_SUPABASE_URL=

# The project's ANON / publishable key. It is public by design; row level security is what protects data.
VITE_SUPABASE_ANON_KEY=

# There is deliberately NO setting for where email links (confirm email, reset password) return to. They always return to the
# origin the page is running on, because the PKCE verifier that completes the flow is stored in that browser for that origin.
# The hosted redirect allow-list must contain exactly <app-origin>/auth/callback and <app-origin>/auth/reset-password, no wildcard.
